# Copy to .env and fill in real values. Never commit .env.

GROBID_URL=http://localhost:8070
GROBID_SERVICE=processFulltextDocument

# Default is 1 (CrossRef / biblio-glutton header enrichment).
# Set 0 for PDF-only headers: CONSOLIDATE_HEADER=0
CONSOLIDATE_HEADER=1

LLM_PROVIDER=createai
CREATEAI_BASE_URL=https://api-main.aiml.asu.edu/v1
CREATEAI_QUERY_URL=https://api-main.aiml.asu.edu/query
ASU_CREATE_AI_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
